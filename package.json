{
  "name": "pitch-snake",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test packages/engine/engine.test.js packages/net/net.test.js",
    "mobile": "npm --workspace apps/mobile run start",
    "install-hooks": "sh scripts/install-hooks.sh",
    "lint": "npm --workspace apps/mobile run lint",
    "typecheck": "npm --workspace apps/mobile run typecheck",
    "lint:page": "eslint page",
    "typecheck:page": "tsc -p page/tsconfig.json --noEmit",
    "build:page": "tsc -p page/tsconfig.json"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "^7.1.1"
  },
  "devDependencies": {
    "@supabase/realtime-js": "^2.112.3"
  }
}
