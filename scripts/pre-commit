#!/bin/sh
# Pre-commit: plain shell, no husky (the False9 approach).
# Fails the commit if the engine tests, the mobile linter, or tsc fail.
set -e
echo "pre-commit: engine tests"
npm test --silent

# The page's modules are TypeScript compiled to page/build/, and that output is
# COMMITTED, because GitHub Pages serves this repo as it stands and there is no
# build step between a push and the live site. Committed output can drift from
# its source, and the drift would be invisible: the page keeps working, just
# not the way the source says. So rebuild and refuse the commit if anything
# moved. Rebuilding also type-checks, which is the point of the .ts files.
echo "pre-commit: page lint + typescript"
npm run lint:page --silent
npm run build:page --silent
if ! git diff --quiet -- page/build; then
  echo
  echo "  page/build is out of date with page/*.ts."
  echo "  It has just been rebuilt; stage it and commit again:"
  echo
  git diff --name-only -- page/build | sed 's/^/    /'
  echo
  echo "    git add page/build"
  echo
  exit 1
fi

# index.html is cached for ten minutes and everything it loads for four hours,
# so a fresh page can meet its own stale modules. When a deploy changes a
# module's exports that pairing does not degrade, it kills the module graph and
# the game does not boot at all. Every URL the page asks for therefore carries a
# content version, and this refuses a commit where the stamp no longer matches
# what is being committed. It runs after build:page because it hashes the built
# output. See scripts/stamp-assets.mjs for the full reasoning.
echo "pre-commit: asset versions"
npm run stamp --silent
if ! git diff --quiet -- index.html; then
  echo
  echo "  index.html asset versions were stale and have just been restamped."
  echo "  Stage it and commit again:"
  echo
  echo "    git add index.html"
  echo
  exit 1
fi

if [ -d apps/mobile/node_modules ]; then
  echo "pre-commit: mobile lint + typecheck"
  npm --workspace apps/mobile run lint --silent
  npm --workspace apps/mobile run typecheck --silent
fi
